# ============================================================================
# Menu-AI v2 — variáveis de ambiente (copie para .env)
# Usado por deploy/docker-compose.yml e pelos serviços em apps/*.
# ============================================================================

# ---- Banco de dados (Postgres + pgvector) ----
POSTGRES_USER=menuai
POSTGRES_PASSWORD=menuai
POSTGRES_DB=menuai
# String de conexão usada pelos serviços (no compose o host é "postgres").
DATABASE_URL=postgres://menuai:menuai@localhost:5432/menuai?sslmode=disable

# ---- Fila (RabbitMQ) ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Mensagens não-confirmadas por worker de IA (controla concorrência). Escale com réplicas.
WORKER_PREFETCH=1

# ---- Integração entre serviços ----
# URL da API Go usada pelas tools do agente Python (no compose: http://api:8080).
API_INTERNAL_URL=http://localhost:8080
# Tempo (s) que a API Go aguarda a resposta do worker de IA (RPC).
CHAT_TIMEOUT_SECONDS=60

# ---- Admin ----
# Token do gate do dashboard de admin (enviado pelo front no header X-Admin-Token).
# Vazio = gate desabilitado (apenas dev). Defina para exigir o token nas rotas /admin.
ADMIN_TOKEN=
# Exposto ao front em build time (o front guarda/usa este token nas chamadas de admin).
VITE_ADMIN_TOKEN=

# ---- Provider de LLM ----
# "ollama" (local, default) ou "anthropic" (Claude API).
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Embeddings (RAG) ----
# Default Ollama nomic-embed-text (768 dim — bate com a coluna vector(768)).
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# ---- Canal Telegram (opcional; usa unidade padrão até reintegração v2) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_DEFAULT_UNIDADE_ID=1

# ---- Front ----
# Embutido no bundle em build time. No compose o default é /api (proxy nginx → api).
VITE_API_URL=/api

# ---- Portas publicadas no host ----
MENUAI_WEB_PORT=5273
MENUAI_API_PORT=8080
MENUAI_AI_PORT=8000
MENUAI_PG_PORT=5432
MENUAI_RABBIT_PORT=5672
MENUAI_RABBIT_UI_PORT=15672
MENUAI_OLLAMA_PORT=11534
