# ============================================================================
# Provider de LLM
# ============================================================================
# "ollama"   → roda local com llama3.2 (default, gratuito, ~30s/turno em CPU)
# "anthropic" → Claude API (~3s/turno, ~R$ 0,01/turno em Haiku)
LLM_PROVIDER=ollama

# ----------------------------------------------------------------------------
# Config Ollama (usado quando LLM_PROVIDER=ollama)
# ----------------------------------------------------------------------------
# Modelo Ollama. Alternativas: mistral (mais leve), qwen2.5 (também faz tool calling).
OLLAMA_MODEL=llama3.2

# ----------------------------------------------------------------------------
# Config Anthropic (usado quando LLM_PROVIDER=anthropic)
# ----------------------------------------------------------------------------
# Cole sua API key (formato sk-ant-...). Obter em https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude. Alternativas:
#   claude-haiku-4-5    → mais rápido e barato (recomendado pra Lia)
#   claude-sonnet-4-6   → qualidade superior, ~3-4× mais caro
#   claude-opus-4-7     → top de linha, ~15× mais caro que Haiku (overkill aqui)
ANTHROPIC_MODEL=claude-haiku-4-5

# ============================================================================
# Canal Telegram (opcional — só preencha se for usar o webhook)
# ============================================================================
# Token do bot, obtido falando com @BotFather (formato 123456:ABC...).
# TELEGRAM_BOT_TOKEN=

# Segredo compartilhado entre o backend e o Telegram. Quando você registra
# o webhook via setWebhook?secret_token=..., o Telegram passa esse valor de
# volta no header `X-Telegram-Bot-Api-Secret-Token` em todo request. Escolha
# uma string aleatória (ex.: `openssl rand -hex 32`). Se ficar vazio, a
# validação é pulada (não recomendado em produção).
# TELEGRAM_WEBHOOK_SECRET=

# ============================================================================
# Portas publicadas no host (defaults afastados das padrão pra evitar conflito)
# ============================================================================
LIA_FRONTEND_PORT=5273
LIA_BACKEND_PORT=8765
LIA_OLLAMA_PORT=11534
