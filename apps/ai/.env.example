# ---- LLM ----
# ollama (local, default) | anthropic (Claude API — rápido, requer chave)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Embeddings (RAG) ----
# nomic-embed-text = 768 dims (precisa bater com a coluna vector(768) do Postgres)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# ---- Integrações ----
API_INTERNAL_URL=http://localhost:8080
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
DATABASE_URL=postgres://menuai:menuai@localhost:5432/menuai?sslmode=disable

# ---- Worker ----
CHAT_REQUESTS_QUEUE=chat.requests
WORKER_PREFETCH=1

# ---- Telegram (opcional) ----
# Crie um bot com @BotFather. Produção: webhook (registre com
# `python -m app.channels.telegram_polling set-webhook https://SEU_HOST/webhook/telegram`).
# Dev local: `python -m app.channels.telegram_polling` (long-polling, sem URL pública).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_UNIDADE_ID=1
